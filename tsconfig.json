{
  "$schema": "https://json.schemastore.org/tsconfig",
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  },
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./backend",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["**/*.spec.ts", "common/tests/**", "types/**", "frontend"]
}
